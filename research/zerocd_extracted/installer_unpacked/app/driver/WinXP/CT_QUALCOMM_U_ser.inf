; Windows XP Virtual Serial Port Setup File
; Copyright (c) 2008-2009 Qualcomm Corporation
; Manufacturer: Qualcomm Corporation
;

[Version]
signature  = "$WINDOWS NT$"
Class      = Ports
Provider   = %QUALCOMM%
ClassGuid  = {4D36E978-E325-11CE-BFC1-08002BE10318}
DriverVer  = 02/01/2009,1.1.0.0
Catalogfile = CT_QUALCOMM_U_ser.cat

[ControlFlags]
ExcludeFromSelect = *

[SourceDisksNames]
  1000 = %QUALCOMMSrcDisk%,"",,

[SourceDisksFiles]
  CT_QUALCOMM_U_drv.sys = 1000

[Manufacturer]
%QUALCOMM% = QUALCOMMSerialPort, NTia64, NTamd64

[QUALCOMMSerialPort]
%QUALCOMMDevice01% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_01
%QUALCOMMDevice02% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_02
%QUALCOMMDevice03% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_03

[QUALCOMMSerialPort.NTia64]
%QUALCOMMDevice01% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_01
%QUALCOMMDevice02% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_02
%QUALCOMMDevice03% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_03

[QUALCOMMSerialPort.NTamd64]
%QUALCOMMDevice01% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_01
%QUALCOMMDevice02% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_02
%QUALCOMMDevice03% = QUALCOMMportInstall01, USB\VID_05C6&PID_6000&MI_03

[QUALCOMMportInstall01.NT]
CopyFiles=QUALCOMMUsbDriverFiles
AddReg = All00, AddReg

[QUALCOMMUsbDriverFiles]
CT_QUALCOMM_U_drv.sys

[DestinationDirs]
DefaultDestDir = 12

[QUALCOMMportInstall01.NT.Services]
AddService=CT_QUALCOMM_U_drv,  0x00000002, QUALCOMM_USBSerialService

[QUALCOMM_USBSerialService]
DisplayName   = "Qualcomm EVDO USB Device for Serial Communication"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\CT_QUALCOMM_U_drv.sys

[All00]
HKR,,NTMPDriver,,CT_QUALCOMM_U_drv.sys

[AddReg]
HKR,,PortSubClass,1,01
HKR,,EnumPropPages32,,"MsPorts.dll,SerialPortPropPageProvider"

[Strings]
QUALCOMM   = "Qualcomm Corporation"
QUALCOMMSRCDISK = "Qualcomm CDMA USB Modem Driver Disk"
QUALCOMMDevice01 = "Qualcomm Command Control Port"
QUALCOMMDevice02 = "Qualcomm Voice Device Port"
QUALCOMMDevice03 = "Qualcomm DM Service port"
